# Server Configuration
PORT=8080
ENV=production
API_URL=http://YOUR_EC2_PUBLIC_IP
FRONTEND_URL=http://YOUR_FRONTEND_DOMAIN

# Database Configuration
POSTGRES_USER=bidzy_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=auction_db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_LIFETIME=5m

# Redis Configuration
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration (CRITICAL: Change this in production!)
JWT_SECRET=CHANGE_THIS_TO_A_VERY_STRONG_SECRET_KEY_AT_LEAST_32_CHARACTERS

# Google OAuth Configuration (Replace with your actual values)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://YOUR_EC2_PUBLIC_IP/auth/google/callback

# SMTP Configuration (Replace with your actual values)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM=your-email@gmail.com
SMTP_SECURE=true 